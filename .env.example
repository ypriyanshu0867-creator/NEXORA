# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
# A dedicated app account, NOT root. `python scripts\init_db.py --bootstrap`
# creates it using the password you put here.
DB_USER=nexora_app
DB_PASSWORD=change-me
DB_NAME=nexora

# Used only by pytest. Must be a DIFFERENT database from DB_NAME.
TEST_DB_NAME=nexora_test

# Server
FLASK_HOST=127.0.0.1
PORT=5000
# 1 = serve HTTPS with a self-signed certificate (needed for phone camera and GPS)
FLASK_HTTPS=0

# Security and attendance settings (defaults shown)
SESSION_HOURS=2
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
QR_VALIDITY_SECONDS=120
DEVICE_COOLDOWN_SECONDS=180
SESSION_DEFAULT_MINUTES=10
ATTENDANCE_MAX_FAILURES_PER_MINUTE=10
DEVICE_COOKIE_MAX_AGE_DAYS=365
# Student portal policies
ATTENDANCE_THRESHOLD_PERCENT=75
GPA_DECIMALS=2
# How CGPA treats a subject taken more than once: latest | best
CGPA_REPEAT_POLICY=latest
# Library fine per overdue day, in your currency. 0 means fines are not configured.
LIBRARY_FINE_PER_DAY=0
PAGE_SIZE=12
# Teacher tools
# 1 = teachers may publish results for their own subjects, 0 = only administrators publish
TEACHER_CAN_PUBLISH_RESULTS=1
MATERIAL_MAX_MB=10
# Production only: how many reverse proxies sit in front of the app (0 = none). Trusts X-Forwarded-* headers.
TRUSTED_PROXY_HOPS=0
